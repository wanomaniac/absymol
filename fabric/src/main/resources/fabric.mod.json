{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"wanomaniac"
	],
	"license": "CC0-1.0",
	"icon": "assets/absymol/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.wano.absymol.AbysmolFabricRoot"
		],
      "preLaunch": [
        "com.wano.absymol.AbysmolFabricPrelaunch"
      ]
	},
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}